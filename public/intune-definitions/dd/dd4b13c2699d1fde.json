{"id":"device_vendor_msft_policy_config_textinput_allowimelogging","displayName":"Allow IME Logging","description":"Note The policy is only enforced in Windows 10 for desktop. Allows the user to turn on and off the logging for incorrect conversion and saving auto-tuning result to a file and history-based predictive input. Most restricted value is 0.","helpText":"","infoUrls":["https://docs.microsoft.com/windows/client-management/mdm/policy-csp-TextInput#allowimelogging"],"categoryId":"cb8e8500-0336-4277-b3d9-9177cc967dcf","categoryName":"Text Input","options":[{"id":"device_vendor_msft_policy_config_textinput_allowimelogging_0","displayName":"Block","description":"Not allowed.","helpText":null},{"id":"device_vendor_msft_policy_config_textinput_allowimelogging_1","displayName":"Allow","description":"Allowed.","helpText":null}]}